#!/usr/bin/env python3
"""Read and edit the dedicated server's sandbox settings.

Usage:  zomboid-sandbox                  show the settings that matter most
        zomboid-sandbox -find <text>     search a setting by name
        zomboid-sandbox -set Key=value   change settings by hand
        zomboid-sandbox -import [Name]   pull in a preset saved in the game
        zomboid-sandbox -edit            open the file in $EDITOR

The comfortable way to tune this is not to edit text: open the game, go to
Solo -> Custom Sandbox, set everything on screen with the game's own
descriptions, save it as a preset, then run -import.

WARNING: zombie population, distribution and the start date are baked into the
world when it is first created. Changing them later does nothing to a world
that already exists -- you need a fresh world for those.
"""
import os, re, shutil, sys, subprocess, pathlib

def _config():
    """Read the same shell config the other scripts use."""
    for c in (os.environ.get("ZOMBOID_OFFLINE_CONFIG"),
              str(pathlib.Path.home() / ".config/zomboid-offline/config.sh"),
              str(pathlib.Path(__file__).resolve().parent.parent / "config.sh")):
        if c and pathlib.Path(c).is_file():
            out = subprocess.run(
                ["bash", "-c", f'. "{c}"; echo "$INSTANCE_DIR"; echo "$SERVER_NAME"'],
                capture_output=True, text=True).stdout.splitlines()
            if len(out) >= 2 and out[0]:
                return pathlib.Path(out[0]), (out[1] or "amigos")
    sys.exit("No config found. Copy config.example.sh to "
             "~/.config/zomboid-offline/config.sh")


INSTANCE, SERVER_NAME = _config()
SV = INSTANCE / f"Server/{SERVER_NAME}_SandboxVars.lua"
PRESETS = [INSTANCE / "Sandbox Presets", pathlib.Path.home() / "Zomboid/Sandbox Presets"]

# the ones that matter most on a co-op server, in the order they bite
HIGHLIGHTS = [
    ("Zombies", "population (1=insane 2=very high 3=high 4=normal 5=low 6=none)"),
    ("ZombieConfig.PopulationMultiplier", "fine population multiplier"),
    ("Distribution", "spread (1=urban focused 2=uniform)"),
    ("ZombieRespawn", "respawn rate (1=high 2=normal 3=low 4=none)"),
    ("ZombieLore.Speed", "speed (1=sprinters 2=fast shamblers 3=shamblers)"),
    ("ZombieLore.Strength", "strength (1=superhuman ... 4=random)"),
    ("ZombieLore.Toughness", "how hard they are to kill (1=tough 3=fragile 4=random)"),
    ("ZombieLore.Transmission", "infection (1=bite only 2=any wound 3=none)"),
    ("MultiplierConfig.Global", "global XP multiplier"),
    ("FoodLootNew", "food loot (1.0 = normal)"),
    ("OtherLootNew", "general loot (1.0 = normal)"),
    ("DayLength", "day length (3=1h 4=1h30 5=2h 6=3h ...)"),
    ("StartMonth", "starting month (1=January ... 12=December)"),
    ("WaterShutModifier", "days until the water is cut"),
    ("ElecShutModifier", "days until the power is cut"),
    ("NightDarkness", "how dark nights are (1=bright ... 4=pitch black)"),
    ("MultiHitZombies", "one swing hitting several zombies"),
    ("Map.MapAllKnown", "whole map revealed from the start"),
    ("Map.AllowMiniMap", "minimap enabled"),
]


def load_text():
    if not SV.exists():
        sys.exit(f"sandbox does not exist yet: {SV}\nrun zomboid-server once.")
    return SV.read_text(encoding="utf-8", errors="replace")


def walk(text):
    """return [(path, value, line_number)] from SandboxVars.lua"""
    stack, found = [], []
    re_abre = re.compile(r'^(\s*)([A-Za-z][A-Za-z0-9_]*)\s*=\s*\{\s*$')
    re_par = re.compile(r'^(\s*)([A-Za-z][A-Za-z0-9_]*)\s*=\s*(.+?),?\s*$')
    for n, line in enumerate(text.splitlines()):
        if re_abre.match(line):
            stack.append(re_abre.match(line).group(2)); continue
        if re.match(r'^\s*\},?\s*$', line):
            if stack: stack.pop()
            continue
        m = re_par.match(line)
        if m:
            found.append((".".join(stack[1:] + [m.group(2)]), m.group(3), n))
    return found


def write_changes(changes):
    """changes: {path: new_value}"""
    text = load_text()
    if not (SV.parent / (SV.name + ".antes-do-preset")).exists():
        shutil.copy2(SV, str(SV) + ".antes-do-preset")
    linhas = text.splitlines()
    changed, not_found = [], []
    index = {c: (v, n) for c, v, n in walk(text)}
    for path, new in changes.items():
        if path not in index:
            not_found.append(path); continue
        old, n = index[path]
        if not re.fullmatch(r'-?\d+(\.\d+)?|true|false', new):
            new = '"%s"' % new.strip('"')
        indent = re.match(r'^(\s*)', linhas[n]).group(1)
        key = path.split(".")[-1]
        linhas[n] = f'{indent}{key} = {new},'
        if old != new:
            changed.append((path, old, new))
    SV.write_text("\n".join(linhas) + "\n", encoding="utf-8")
    return changed, not_found


def find_preset(name):
    for d in PRESETS:
        for cand in (d / f"{name}.cfg", d / name):
            if cand.exists():
                return cand
    available = sorted({p.stem for d in PRESETS if d.is_dir() for p in d.glob("*.cfg")})
    sys.exit(f"preset '{name}' not found. Available: {', '.join(available) or '(none)'}")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""

    if arg == "-import":
        name = sys.argv[2] if len(sys.argv) > 2 else "New"
        cfg = find_preset(name)
        preset = {}
        for line in cfg.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line[0] in "#-" or "=" not in line:
                continue
            k, v = line.split("=", 1)
            preset[k.strip()] = v.strip()
        if "Version" in preset:
            preset["VERSION"] = preset.pop("Version")
        changed, missing = write_changes(preset)
        print(f"preset '{name}' applied: {len(preset) - len(missing)} of {len(preset)} settings")
        if changed:
            print(f"  {len(changed)} changed:")
            for c, a, b in changed[:15]:
                print(f"    {c}: {a} -> {b}")
            if len(changed) > 15:
                print(f"    ... and {len(changed)-15} more")
        if missing:
            print(f"  {len(missing)} do not exist on this server (mod disabled): "
                  + ", ".join(missing[:6]) + (" ..." if len(missing) > 6 else ""))
        print("\nrestart the server to apply: zomboid-server -stop && zomboid-server")
        return

    if arg == "-set":
        pairs = {}
        for a in sys.argv[2:]:
            if "=" not in a:
                sys.exit(f"expected Key=value, got: {a}")
            k, v = a.split("=", 1)
            pairs[k.strip()] = v.strip()
        changed, missing = write_changes(pairs)
        for c, a, b in changed:
            print(f"{c}: {a} -> {b}")
        for c in missing:
            print(f"no such setting: {c}   (search with: zomboid-sandbox -find {c.split('.')[-1]})")
        if changed:
            print("\nrestart the server to apply: zomboid-server -stop && zomboid-server")
        return

    if arg == "-find":
        query = (sys.argv[2] if len(sys.argv) > 2 else "").lower()
        for c, v, _ in walk(load_text()):
            if query in c.lower():
                print(f"  {c:<44} = {v}")
        return

    if arg == "-edit":
        ed = os.environ.get("EDITOR") or shutil.which("kate") or shutil.which("nano") or "vi"
        subprocess.call([ed, str(SV)])
        return

    if arg in ("-h", "--help"):
        print(__doc__)
        return

    values = {c: v for c, v, _ in walk(load_text())}
    print(f"sandbox: {SV}\n")
    for key, explain in HIGHLIGHTS:
        print(f"  {key:<26} = {values.get(key, '(missing)'):<8}  {explain}")
    print(f"\n  ({len(values)} settings in total -- search with -find, change with -set)")


main()
